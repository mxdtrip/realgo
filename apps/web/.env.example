# Base URL of the Go API. Used by the web API client (app/_api).
# Copy to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Dev-only: set to 1 to open the cabinet UI without logging in (skips the auth
# guard). Useful for working on cabinet pages on mocks before the backend is up.
# Leave unset in production.
# NEXT_PUBLIC_AUTH_BYPASS=1

# "Войти через Яндекс ID" button (app/_auth/YandexAuthButton.tsx). This is the
# OAuth client id, not a secret — it's inlined into the browser bundle. Get it
# by registering the app at https://oauth.yandex.ru/ ("Веб-сервисы", type
# "Для авторизации пользователей") and adding this origin's
# /auth/yandex/callback as a redirect URI. The matching YANDEX_CLIENT_SECRET
# lives server-side only, in the root .env (see services/api/.env.example).
# Leave empty to hide the button.
NEXT_PUBLIC_YANDEX_CLIENT_ID=

# "Войти через GitHub" button (app/_auth/GithubAuthButton.tsx). OAuth App
# client id, not a secret. Get it by creating an OAuth App at
# https://github.com/settings/developers and setting its "Authorization
# callback URL" to this origin's /auth/github/callback. The matching
# GITHUB_CLIENT_SECRET lives server-side only, in the root .env (see
# services/api/.env.example). Leave empty to hide the button.
NEXT_PUBLIC_GITHUB_CLIENT_ID=
