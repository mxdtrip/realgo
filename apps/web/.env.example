# Base URL of the Go API. Used by the web API client (app/_api).
# Copy to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Dev-only: set to 1 to open the cabinet UI without logging in (skips the auth
# guard). Useful for working on cabinet pages on mocks before the backend is up.
# Leave unset in production.
# NEXT_PUBLIC_AUTH_BYPASS=1

# Confirm-email delivery (app/api/internal/send-verification-email). This is
# the only place SMTP credentials live — the Go API calls this route over
# HTTP instead of sending mail itself. Leave SMTP_HOST empty to have the
# route log the confirmation link instead of sending it (local dev without a
# real mailbox).
SMTP_HOST=smtp.freesmtpservers.com
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ReAlgo <no-reply@realgo.dev>

# Shared secret the api authenticates itself with when it calls the route
# above. Must match services/api's MAILER_WEB_INTERNAL_SECRET exactly.
INTERNAL_MAIL_SECRET=
