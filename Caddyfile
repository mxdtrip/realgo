# Public direct-deploy entry point. The reverse-tunnel home stack uses
# Caddyfile.internal instead, because the VPS edge terminates TLS there.
{$REALGO_SITE_ADDRESS:realgo.dev} {
	encode zstd gzip
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@admin path /admin /admin/*
	handle @admin {
		respond 404
	}

	@api path /api/* /healthz /readyz
	@allowed_origin header_regexp Origin ^(https?://(localhost|127[.]0[.]0[.]1):(5173|3000)|{$REALGO_EXTENSION_ORIGIN:chrome-extension://kclglopmphebagjjimjhdpnmoddmbgea})$

	handle @api {
		route {
			header @allowed_origin Access-Control-Allow-Origin "{http.request.header.Origin}"
			header @allowed_origin Access-Control-Allow-Credentials "true"
			header @allowed_origin Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
			header @allowed_origin Access-Control-Allow-Headers "Authorization, Content-Type"
			header @allowed_origin Access-Control-Max-Age "86400"
			header @allowed_origin Vary "Origin"

			@preflight method OPTIONS
			respond @preflight 204

			reverse_proxy api:8080
		}
	}

	# Final product presentation (apps/presentation), served by its own nginx.
	# The deck references every asset relatively (assets/..., vendor/...), so it
	# must be entered with a trailing slash — otherwise the browser resolves
	# those against the site root and Next.js answers 404s. The redirect makes
	# the bare /presentation link in the footer and in the hackathon notice
	# safe.
	@presentation_bare path /presentation
	redir @presentation_bare /presentation/ 308

	handle_path /presentation/* {
		reverse_proxy presentation:80
	}

	# Everything that isn't /api/* or /presentation/* is the Next.js app.
	handle {
		reverse_proxy web:3000
	}
}
