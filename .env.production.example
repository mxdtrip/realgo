# ReAlgo production environment for a manual server deploy.
# Copy to .env.production, replace every `change-me`, and never commit it.

APP_ENV=production
APP_VERSION=production-manual
# Replace with `git rev-parse HEAD`; GitHub Actions supplies it automatically.
COMMIT_SHA=0000000000000000000000000000000000000000

DB_USER=postgres
DB_PASSWORD=change-me-production-database-password
DB_NAME=freeburger
REDIS_PASSWORD=change-me-production-redis-password

AUTH_JWT_SECRET=change-me-to-at-least-32-random-characters
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h

MAIL_BASE_URL=https://realgo.dev
MAIL_ENABLED=true
MAIL_SMTP_TIMEOUT=10s
SMTP2GO_SMTP_HOST=mail.smtp2go.com
SMTP2GO_SMTP_PORT=2525
SMTP2GO_SMTP_TLS_MODE=starttls
SMTP2GO_SMTP_USERNAME=change-me
SMTP2GO_SMTP_PASSWORD=change-me

FRP_VPS_HOST=change-me
FRP_TOKEN=change-me
VPN_SUB_URL=change-me

# Optional AI, OAuth and admin features.
GEMINI_API_KEY=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOADMIN_USERNAME=
GOADMIN_PASSWORD=

REALGO_SITE_ADDRESS=realgo.dev
REALGO_EXTENSION_ORIGIN=chrome-extension://kclglopmphebagjjimjhdpnmoddmbgea
NEXT_PUBLIC_API_BASE_URL=
TRUSTED_PROXY_CIDRS=

# Only for an intentionally disposable demo; normal production does not run
# seed-users.
SEED_USERS_PASSWORD=
